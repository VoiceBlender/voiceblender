# VoiceBlender configuration — example with default values.
#
# Copy this file to `voiceblender.env` and adjust as needed:
#   cp voiceblender.env.example voiceblender.env
#
# `voiceblender.env` is intentionally untracked (it may hold credentials).
# Keep THIS file in sync with `internal/config/config.go` — every env var the
# server reads should appear here with its real default value.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# Instance identifier; included in API responses and webhook events.
# Leave blank to auto-generate a UUID on each start.
INSTANCE_ID=

# ---------------------------------------------------------------------------
# SIP signalling
# ---------------------------------------------------------------------------
SIP_BIND_IP=127.0.0.1
# IPv6 address advertised in SDP/Contact/Via for v6 calls. Empty = v4-only.
SIP_BIND_IPV6=
# UDP socket bind. Empty = same as SIP_BIND_IP.
SIP_LISTEN_IP=
# IPv6 socket bind. Empty = same as SIP_BIND_IPV6.
SIP_LISTEN_IPV6=
# Public IPv4 address for NAT/Docker; used in Contact + SDP c= when set.
SIP_EXTERNAL_IP=
SIP_PORT=5060
# SIP-over-TLS port (typically 5061). Empty = TLS disabled.
SIP_TLS_PORT=
SIP_TLS_CERT=
SIP_TLS_KEY=
SIP_TLS_CA_FILE=
SIP_TLS_INSECURE_SKIP_VERIFY=false
SIP_DEBUG=false
# FQDN advertised in From/Contact/Via on outbound SIP. Empty = use IP.
SIP_DOMAIN=
SIP_HOST=voiceblender
# Preference-ordered codec list (PCMU, PCMA, G722, opus, AMR-WB, AMR-NB).
SIP_CODECS=PCMU,PCMA
SIP_REFER_AUTO_DIAL=false
# How long an inbound REFER is parked awaiting an app accept/decline decision
# (transfer commands) before auto-declining 603. Only used when auto-dial is off.
SIP_REFER_CONSULT_TIMEOUT_MS=2000
SIP_AUTO_RINGING=false
SIP_USE_SOURCE_SOCKET=false
# Listen for SIP over TCP on SIP_PORT alongside UDP. Recommended with SIPREC:
# a recording session's INVITE is larger than RFC 3261 18.1.1 allows over UDP.
SIP_TCP_ENABLED=false
SIP_JITTER_BUFFER_MS=0
SIP_JITTER_BUFFER_MAX_MS=300
# WebSocket ingress playout lead (websocket legs and room WS participants).
# 0 = passthrough. Non-zero also enables clock-drift compensation. Size it to
# the worst-case transport stall, not to the drift: 40-80 suits a healthy link,
# and every millisecond is added one-way latency.
WS_JITTER_BUFFER_MS=0
COMFORT_NOISE_ENABLED=true
# Answer every offered m= section, using port 0 for the ones we don't accept
# (RFC 3264 section 6). Changes single-stream SDP when a peer offers video.
SIP_SDP_STRICT_MLINE_ANSWER=false

# SIP REGISTER / AOR registry
SIP_REGISTRATION_DEFAULT_EXPIRES_SECONDS=3600
SIP_REGISTRATION_MAX_EXPIRES_SECONDS=7200
SIP_REGISTRATION_SWEEP_INTERVAL_MS=1000
SIP_REGISTRATION_ALLOW_MULTIPLE_CONTACTS=true

# Inbound digest auth (challenge inbound INVITE / REGISTER). A VSI/REST client
# decides per request whether to challenge; VoiceBlender issues the 401 and
# verifies the credentialed retry. CONSULT_TIMEOUT bounds how long an inbound
# REGISTER is parked awaiting a decision before the fallback applies.
# REGISTER_DEFAULT is that fallback for an undecided REGISTER: "reject" (403,
# fail-closed default) or "accept" (bind — the legacy fail-open behaviour).
# NONCE_TTL bounds an issued challenge nonce lifetime.
SIP_INBOUND_AUTH_CONSULT_TIMEOUT_MS=2000
SIP_INBOUND_REGISTER_DEFAULT=reject
SIP_INBOUND_AUTH_NONCE_TTL_SECONDS=60

# SIP outbound REGISTER (trunks) — VoiceBlender as a UAC registering to an
# upstream SIP registrar/PBX. See POST /v1/sip/trunks.
SIP_OUTBOUND_REGISTRATION_DEFAULT_EXPIRES_SECONDS=3600
SIP_OUTBOUND_REGISTRATION_MIN_EXPIRES_SECONDS=60
SIP_OUTBOUND_REGISTRATION_MAX_EXPIRES_SECONDS=7200
SIP_OUTBOUND_REGISTRATION_REFRESH_RATIO=0.5
SIP_OUTBOUND_REGISTRATION_FAILURE_BACKOFF_MAX_MS=300000

# Default next hop for outbound REGISTERs and INVITEs, sent as a loose Route
# header with the Request-URI left unchanged. Overridden per-trunk by
# sip_register.outbound_proxy and per-call by outbound_proxy on POST /v1/legs.
# Empty routes straight at the registrar / dialed URI. e.g.
# sip:edge.example.com:5060;transport=tcp
SIP_OUTBOUND_PROXY=

# AMR-WB (G.722.2) — speech-mode ceiling 0..8, octet-aligned framing offer.
AMRWB_MODE=2
AMRWB_OCTET_ALIGNED=true

# AMR-NB — speech-mode ceiling 0..7, octet-aligned framing offer.
AMRNB_MODE=7
AMRNB_OCTET_ALIGNED=true

# ---------------------------------------------------------------------------
# HTTP API
# ---------------------------------------------------------------------------
HTTP_ADDR=:8080
# Comma-separated allowlist of IPs and CIDR ranges (v4 + v6 mixable).
# Empty = accept any source. Gates REST, /v1/vsi, /v1/legs/websocket,
# /v1/legs/moq, /metrics, and pprof.
# Examples: 127.0.0.1,10.0.0.0/8  |  2001:db8::/32,::1
ALLOWED_IPS=
# When true, leftmost X-Forwarded-For is used as the client IP for the
# ALLOWED_IPS check. Enable only behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Media / RTP
# ---------------------------------------------------------------------------
RTP_PORT_MIN=10000
RTP_PORT_MAX=20000
ICE_SERVERS=stun:stun.l.google.com:19302
# Comma-separated public IPs advertised as host ICE candidates (pion
# SetNAT1To1IPs). Set this when VB runs behind NAT/Docker and the gathered
# host interface IPs aren't routable from the remote WebRTC peer. Supports
# IPv4 and IPv6 literals. The literal value "auto" triggers STUN-based
# public-IP discovery at startup using the configured ICE_SERVERS. Leave
# empty to gather host candidates as-is.
WEBRTC_EXTERNAL_IPS=
DEFAULT_SAMPLE_RATE=16000
SPEECH_DETECTION_ENABLED=false
# Per-client buffer size on the /v1/vsi WebSocket; clamped to [16, 1_000_000].
VSI_EVENT_BUFFER_SIZE=256

# ---------------------------------------------------------------------------
# Recording / storage
# ---------------------------------------------------------------------------
RECORDING_DIR=/tmp/recordings
# The bucket is probed with HeadBucket when the backend is built, so a bucket
# that does not exist fails at startup (exit 1) instead of after a recording has
# been captured. A probe that cannot get a verdict — 403 because the credentials
# have s3:PutObject but not s3:ListBucket, a 5xx, an unreachable endpoint — is
# only warned about, and recording proceeds.
S3_BUCKET=
S3_REGION=us-east-1
# Must include an http:// or https:// scheme.
S3_ENDPOINT=
S3_PREFIX=
# Allow a plaintext http:// S3_ENDPOINT on a non-local host, rather than shipping
# recording audio in cleartext. Loopback, private and link-local addresses,
# single-label hostnames (http://minio:9000) and .internal/.local names are
# exempt and need no opt-in, so a co-located MinIO works without this.
S3_ALLOW_INSECURE_ENDPOINT=false
# Budgets for the bucket probe; 0 disables it. The per-request one is short
# because it runs inside record-start, which on VSI occupies the connection's
# command loop.
S3_PREFLIGHT_TIMEOUT=10s
S3_REQUEST_PREFLIGHT_TIMEOUT=2s
# AWS credentials for S3 uploads (and AWS Polly TTS when no per-request
# api_key is supplied) are resolved by the AWS SDK's default credential
# chain, not by VoiceBlender directly. In order of precedence:
#   1. Static env vars: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
#      AWS_SESSION_TOKEN (optional, for temporary creds)
#   2. AWS_PROFILE pointing at a section in ~/.aws/credentials
#   3. EC2 / ECS / EKS instance role (IMDSv2)
# AWS_REGION is consulted only if S3_REGION is empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
# AWS_REGION is honored by the SDK only when S3_REGION above is empty.
AWS_REGION=
# Google Cloud Storage via the native GCS API (storage=gcs on a record request).
# Preferred over S3_ENDPOINT=https://storage.googleapis.com on GKE: credentials
# come from Application Default Credentials / Workload Identity, so no HMAC
# interop keys are needed. Set GOOGLE_APPLICATION_CREDENTIALS below when running
# outside GCP. Independent of S3_BUCKET — either or both may be configured.
GCS_BUCKET=
# Prefix applied to every uploaded object name (e.g. recordings, or a bare
# workspace id). A trailing slash is added automatically when missing.
GCS_OBJECT_NAME_PREFIX=

# ---------------------------------------------------------------------------
# TTS cache
# ---------------------------------------------------------------------------
TTS_CACHE_ENABLED=false
TTS_CACHE_DIR=/tmp/tts_cache
TTS_CACHE_INCLUDE_API_KEY=false

# ---------------------------------------------------------------------------
# TTS preflight (speculative synthesis)
# ---------------------------------------------------------------------------
# How long an utterance staged by POST /v1/legs/{id}/tts/preflight is held
# before it is discarded. A leak backstop, not a policy knob — a speculative
# reply is normally committed or discarded within a second.
TTS_PREFLIGHT_TTL=30s
# Maximum staged utterances per leg. Staging past the cap is refused with 409
# rather than evicting an utterance the app may be about to commit.
TTS_PREFLIGHT_MAX_PER_LEG=3
# Maximum buffered audio per staged utterance, in bytes (4 MiB ≈ 2 minutes of
# 16kHz mono PCM16).
TTS_PREFLIGHT_MAX_BYTES=4194304

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
WEBHOOK_URL=
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Third-party AI / speech providers (per-request keys override these)
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
VAPI_API_KEY=
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
SPEECHMATICS_API_KEY=
# Point at another region (eu, us, global) or a self-hosted realtime container.
SPEECHMATICS_URL=wss://eu2.rt.speechmatics.com/v2
# Google Cloud TTS uses Application Default Credentials (ADC) when no
# per-request api_key is supplied. The Google SDK resolves them, not
# VoiceBlender directly. In order of precedence:
#   1. GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account JSON file
#   2. gcloud user creds at ~/.config/gcloud/application_default_credentials.json
#   3. GCE / Cloud Run / GKE instance metadata
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# SIPREC session recording server (RFC 7865 / RFC 7866)
# ---------------------------------------------------------------------------
# Accept inbound recording sessions forked from an SBC or PBX. Requires
# SIP_TCP_ENABLED=true.
SIPREC_ENABLED=false
# Answer a recording session immediately rather than parking it until
# POST /v1/legs/{id}/answer. A recording client does not wait for a decision.
SIPREC_AUTO_ANSWER=true
SIPREC_MAX_STREAMS=8
SIPREC_METADATA_MAX_BYTES=65536
SIPREC_AUTO_RECORD=false
# Allow POST /v1/rooms/{id}/siprec to fork a room to an external recording
# server. Off by default: it streams room audio to an arbitrary SIP destination.
SIPREC_SRC_ENABLED=false
# none | per_session | fixed. "per_session" creates room siprec-<legID> and
# attaches every recorded stream, which is what makes STT and agents apply to a
# passively recorded call. "fixed" uses SIPREC_ROOM_ID.
SIPREC_ROOM_MODE=none
SIPREC_ROOM_ID=

# ---------------------------------------------------------------------------
# MoQ (Media over QUIC) — experimental
# ---------------------------------------------------------------------------
MOQ_ENABLED=false
MOQ_LISTEN_ADDR=:8443
MOQ_TLS_CERT_FILE=
MOQ_TLS_KEY_FILE=
MOQ_OPUS_BITRATE=24000

# ---------------------------------------------------------------------------
# LiveKit
# ---------------------------------------------------------------------------
LIVEKIT_ENABLED=false
LIVEKIT_URL=
LIVEKIT_OPUS_BITRATE=24000
LIVEKIT_TOKEN_SIGNING_ENABLED=false
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_DEFAULT_TOKEN_TTL=6h

# ---------------------------------------------------------------------------
# SmartTurn turn detection (requires a running smartturn-go microservice)
# https://github.com/VoiceBlender/smartturn-go
# ---------------------------------------------------------------------------
# Enable turn detection globally for all legs (false = opt-out; per-leg turn_detection field overrides).
SMART_TURN_ENABLED=false
# Base URL of the SmartTurn microservice (scheme + host + port, no path), e.g. http://smartturn:8080
SMART_TURN_URL=
# Transport: "ws" (default, persistent streaming WebSocket) or "http" (stateless, one request per pause)
SMART_TURN_TRANSPORT=ws
# WS mode only: VAD engine on SmartTurn ("silero" default, or "rms")
SMART_TURN_VAD=silero
# Probability threshold for TURN_COMPLETE decisions (0.0–1.0; default 0.55)
SMART_TURN_THRESHOLD=0.55
# Milliseconds of silence that trigger audio evaluation (default 500)
SMART_TURN_PAUSE_DURATION_MS=500
# WS mode only: enable adaptive duration-based thresholding on the SmartTurn server (default false)
SMART_TURN_ADAPTIVE=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
